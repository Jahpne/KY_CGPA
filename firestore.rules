rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'augusdavik@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isPremium(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.premiumUntil != null && u.premiumUntil > request.time;
    }

    // One record per person. Only the admin can change plan / premiumUntil.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.plan == 'free'
        && request.resource.data.premiumUntil == null;
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastLogin', 'name', 'photo']));
      allow delete: if isAdmin();

      // Saved courses / grades backup (small)
      match /data/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && request.resource.data.json.size() < 300000;
        allow delete: if isOwner(uid);
      }

      // Result files: only active premium users can upload; owners can always read/delete
      match /files/{fileId} {
        allow read, delete: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && isPremium(uid);

        match /chunks/{chunkId} {
          allow read, delete: if isOwner(uid) || isAdmin();
          allow create, update: if isOwner(uid) && isPremium(uid);
        }
      }
    }

    // "I've paid" notices shown in the admin panel
    match /claims/{uid} {
      allow create, update: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email;
      allow read, delete: if isOwner(uid) || isAdmin();
    }
  }
}
